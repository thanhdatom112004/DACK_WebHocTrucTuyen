# Sao chép thành backend/.env và điền giá trị.
# Trong MONGODB_URI nhớ có tên database trong path (vd .../ten_db?...).

PORT=3001
JWT_SECRET=thay-bang-chuoi-bi-mat-dai

# Tùy chọn: tạo user admin khi chạy npm run seed:roles
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=YourStr0ng!Pass
# ADMIN_EMAIL=admin@example.com

MONGODB_URI=mongodb://127.0.0.1:27017/onlinelearning

# SMTP — bắt buộc để gửi OTP quên mật khẩu / xác thực email (profile)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# PASSWORD_RESET_OTP_MINUTES=10
# EMAIL_VERIFY_OTP_MINUTES=15

# Chat hỗ trợ — tùy chọn: ObjectId user inbox (nếu không set, server tạo `support_studylab_inbox`)
# SUPPORT_USER_ID=
